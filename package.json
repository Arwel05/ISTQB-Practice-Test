{
  "name": "testpilot-ctfl",
  "version": "1.7.0",
  "private": true,
  "description": "Trainer CTFL italiano, portatile e offline",
  "scripts": {
    "build": "node scripts/build.js",
    "build:web": "node scripts/build.js && node scripts/build-web.js",
    "test": "node scripts/build.js && node scripts/build-web.js && node --test tests/*.test.js",
    "start": "node scripts/serve.js",
    "start:web": "node scripts/serve.js web",
    "review:en": "node scripts/review-sheet.js",
    "check:agile-sample": "node scripts/check-agile-sample.js",
    "review:agile": "node scripts/review-agile.js",
    "check:terms": "node scripts/check-terms.js"
  }
}
